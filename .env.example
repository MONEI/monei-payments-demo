# MONEI test-mode credentials — Dashboard → Settings → API Access
# Test and live keys are different; this demo is built for TEST mode.

# Public. Rendered into the page, because every Component needs it.
MONEI_ACCOUNT_ID=

# Server-side only. Never send this to the browser.
MONEI_API_KEY=

# OPTIONAL. Public host used to build completeUrl / cancelUrl / callbackUrl.
# Blank means the host each request came in on. MONEI cannot deliver the webhook
# to localhost, so set this to a tunnel hostname to receive it:
#   npm run dev:tunnel                               # dev server that accepts *.trycloudflare.com
#   cloudflared tunnel --url http://localhost:4321   # public HTTPS URL that forwards to it
HOSTNAME=
