# MONEI test-mode credentials — Dashboard → Settings → API Access
# Test and live keys are different; this demo is built for TEST mode.
MONEI_ACCOUNT_ID=
MONEI_API_KEY=

# Public host used to build completeUrl / cancelUrl / callbackUrl.
# MONEI rejects non-HTTPS URLs here, and localhost is unreachable from its
# servers, so point this at your tunnel hostname while developing:
#   npm run dev:https      # local HTTPS on :4321
#   npm run tunnel         # public HTTPS URL that forwards to it
HOSTNAME=

# OPTIONAL. 
# Signs the shipping quotes that /api/shipping-rates issues and
# /api/payment verifies, so the charged amount cannot be set by the browser.
# Leave blank and MONEI_API_KEY is used instead — one less thing to set up.
# In a real store, use a dedicated secret so rotating the API key does not
# invalidate in-flight quotes:  node -e "console.log(crypto.randomUUID())"
QUOTE_SECRET=
