---
const {theme, flow} = Astro.props;

const redirect = flow === 'redirect';

/**
 * The SDK toggles `monei-component--focus|--invalid|--empty|--complete` on
 * whichever element is handed to render(), so the border and ring styling below
 * lives on the merchant's own box rather than inside the iframe.
 */
const part = `monei-part ${theme.page.radius} border ${theme.page.border} bg-white px-3 py-2`;
const label = `block text-xs font-medium ${theme.page.muted}`;
---

<section class={`${theme.page.surface} ${theme.page.radius} border ${theme.page.border} p-6`}>
  <div id="card-fields" hidden={redirect}>
    <h2 class={`text-sm ${theme.page.heading}`}>Card details</h2>
    {
      theme.cardUi === 'parts' ? (
        <div class="mt-4 space-y-3">
          <div>
            <span class={label}>Card number</span>
            <div class={`mt-1 ${part}`} id="card-number" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <span class={label}>Expiry</span>
              <div class={`mt-1 ${part}`} id="card-expiry" />
            </div>
            <div>
              <span class={label}>CVC</span>
              <div class={`mt-1 ${part}`} id="card-cvc" />
            </div>
          </div>
        </div>
      ) : (
        <div class="mt-4">
          <span class={label}>Card</span>
          <div class={`mt-1 ${part}`} id="card-input" />
        </div>
      )
    }
  </div>
  {
    redirect && (
      <div>
        <h2 class={`text-sm ${theme.page.heading}`}>Hosted payment page</h2>
        <p class={`mt-1 text-xs ${theme.page.muted}`}>
          The payment is created here and the shopper finishes on MONEI's own page, so no card data touches this site.
        </p>
      </div>
    )
  }
  <div class="mt-5">
    <h3 class={`${label} flex items-center gap-2`}>
      Shipping
      <span class="spinner" id="shipping-spinner" aria-hidden="true"></span>
    </h3>
    <div class="mt-2 space-y-1.5" id="shipping-options">
      <p class={`text-xs ${theme.page.muted}`}>Enter an address to see rates.</p>
    </div>
    <p class="mt-2 text-xs text-amber-700" id="bizum-band-shipping" hidden></p>
  </div>
  <p class="mt-4 text-xs text-rose-600" id="pay-error" hidden></p>
  <button
    type="button"
    id="pay"
    disabled
    class={`${theme.page.radius} mt-4 w-full cursor-pointer px-4 py-2.5 text-sm font-medium text-white disabled:cursor-not-allowed disabled:opacity-50`}
    style={`background: ${theme.page.accent}`}
  >
    {redirect ? 'Continue to payment' : 'Pay'}
  </button>
  <div id="bizum-row" hidden>
    <div class={`my-4 flex items-center gap-3 text-xs ${theme.page.muted}`}>
      <span class={`h-px flex-1 border-t ${theme.page.border}`}></span>
      or
      <span class={`h-px flex-1 border-t ${theme.page.border}`}></span>
    </div>
    <div id="bizum"></div>
    <p class={`mt-2 text-xs ${theme.page.muted}`}>In test mode the total decides whether Bizum approves.</p>
  </div>
</section>
