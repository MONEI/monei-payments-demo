---
import ProductArt from './product-art.astro';
import {formatPrice} from '../lib/cart.js';

const {theme, lines, total} = Astro.props;
---

<section class={`${theme.page.surface} ${theme.page.radius} border ${theme.page.border} p-6`}>
  <h2 class={`text-sm ${theme.page.heading}`}>Your order</h2>
  <ul class="mt-2 space-y-1">
    {
      lines.map((line) => (
        <li class={`${theme.page.radius} -mx-2 flex items-start gap-3 p-2`} data-cart-line={line.id}>
          <ProductArt art={line.art} class={`h-10 w-10 shrink-0 ${theme.page.muted}`} />
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium">{line.name}</p>
            <p class={`text-xs ${theme.page.muted}`}>{formatPrice(line.price)} each</p>
            <div class="mt-1.5 flex items-center gap-1.5">
              <button
                type="button"
                class={`${theme.page.radius} cursor-pointer border ${theme.page.border} px-1.5 leading-none disabled:cursor-default disabled:opacity-40`}
                data-cart-step={line.id}
                data-delta="-1"
                aria-label={`One fewer ${line.name}`}
              >
                −
              </button>
              <span class="min-w-4 text-center text-xs tabular-nums">{line.quantity}</span>
              <button
                type="button"
                class={`${theme.page.radius} cursor-pointer border ${theme.page.border} px-1.5 leading-none disabled:cursor-default disabled:opacity-40`}
                data-cart-step={line.id}
                data-delta="1"
                aria-label={`One more ${line.name}`}
              >
                +
              </button>
            </div>
          </div>
          <span class="flex items-center gap-1.5 self-start">
            <span class="spinner" aria-hidden="true" />
            <span class="text-sm tabular-nums">{formatPrice(line.lineTotal)}</span>
          </span>
        </li>
      ))
    }
  </ul>
  <dl class={`mt-6 space-y-1.5 border-t ${theme.page.border} pt-4 text-sm`}>
    <div class="flex justify-between">
      <dt class={theme.page.muted}>Subtotal</dt>
      <dd class="tabular-nums">{formatPrice(total)}</dd>
    </div>
    <div class="flex justify-between">
      <dt class={theme.page.muted}>Shipping</dt>
      <dd class={`tabular-nums ${theme.page.muted}`} id="cart-shipping">—</dd>
    </div>
    <div class={`flex justify-between border-t ${theme.page.border} pt-3 font-medium`}>
      <dt>Total</dt>
      <dd class="tabular-nums" id="cart-total">{formatPrice(total)}</dd>
    </div>
  </dl>
</section>
