---
import ProductArt from './product-art.astro';
import {formatPrice} from '../lib/cart.js';
import {PRODUCTS} from '../data/products.js';

const {theme, lines, total} = Astro.props;

// Every product gets a row, hidden until it is in the basket. The artwork is an
// inline SVG only this component can render, so adding an item client-side reveals
// a row rather than building one.
const rows = PRODUCTS.map((product) => ({
  product,
  line: lines.find((l) => l.id === product.id)
}));

const stepButton = `${theme.page.radius} cursor-pointer border ${theme.page.border} px-1.5 leading-none disabled:cursor-default disabled:opacity-40`;
const lineRow = `${theme.page.radius} -mx-2 flex items-start gap-3 p-2`;
---

<section class={`${theme.page.surface} ${theme.page.radius} border ${theme.page.border} p-6`}>
  <h2 class={`text-sm ${theme.page.heading}`}>Your order</h2>
  <ul class="mt-2 space-y-1">
    {
      rows.map(({product, line}) => (
        <li class={lineRow} data-cart-line={product.id} hidden={!line}>
          <ProductArt art={product.art} class={`h-10 w-10 shrink-0 ${theme.page.muted}`} />
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium">{product.name}</p>
            <p class={`text-xs ${theme.page.muted}`}>{formatPrice(product.price)} each</p>
            <div class="mt-1.5 flex items-center gap-1.5">
              <button
                type="button"
                class={stepButton}
                data-cart-step={product.id}
                data-delta="-1"
                aria-label={`One fewer ${product.name}`}
              >
                −
              </button>
              <span class="min-w-4 text-center text-xs tabular-nums" data-cart-qty>
                {line?.quantity ?? 0}
              </span>
              <button
                type="button"
                class={stepButton}
                data-cart-step={product.id}
                data-delta="1"
                aria-label={`One more ${product.name}`}
              >
                +
              </button>
            </div>
          </div>
          <span class="flex items-center gap-1.5 self-start">
            <span class="spinner" aria-hidden="true" />
            <span class="text-sm tabular-nums" data-cart-line-total>
              {formatPrice(line?.lineTotal ?? 0)}
            </span>
          </span>
        </li>
      ))
    }
  </ul>
  <dl class={`mt-6 space-y-1.5 border-t ${theme.page.border} pt-4 text-sm`}>
    <div class="flex justify-between">
      <dt class={theme.page.muted}>Subtotal</dt>
      <dd class="tabular-nums" id="cart-subtotal">{formatPrice(total)}</dd>
    </div>
    <div class="flex justify-between">
      <dt class={theme.page.muted}>Shipping</dt>
      <dd class={`tabular-nums ${theme.page.muted}`} id="cart-shipping">—</dd>
    </div>
    <div class={`flex justify-between border-t ${theme.page.border} pt-3 font-medium`}>
      <dt>Total</dt>
      <dd class="tabular-nums" id="cart-total">{formatPrice(total)}</dd>
    </div>
  </dl>
  <p class="mt-3 text-xs text-amber-700" id="bizum-band" hidden></p>
</section>
