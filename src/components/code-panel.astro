---
import {codeToHtml} from 'shiki';
import {clientSnippet, serverSnippet} from '../lib/snippet.js';

const {theme, config, clientConfig} = Astro.props;

/**
 * Highlighted here rather than in the browser: the snippets are built from the live
 * config on the server, so shipping a highlighter to the client would only repeat
 * work already done. Shiki wraps its output in a `<pre><code>` carrying its own
 * background; only the inside is kept, so the panel keeps the page's styling.
 */
const highlight = async (code, lang) => {
  const html = await codeToHtml(code, {lang, theme: 'github-light'});
  return html.replace(/^<pre[^>]*><code[^>]*>/, '').replace(/<\/code><\/pre>$/, '');
};

const TABS = [
  {id: 'client', label: 'Client', code: clientSnippet(clientConfig), lang: 'html'},
  {id: 'server', label: 'Server', code: serverSnippet(clientConfig), lang: 'js'}
];

const panes = await Promise.all(TABS.map(async (t) => ({...t, html: await highlight(t.code, t.lang)})));

const tab = `cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium`;
---

<aside
  id="code-rail"
  data-open={String(config.code)}
  class="fixed top-0 right-0 z-40 flex h-full"
  style={`--rail-accent: ${theme.page.accent}`}
>
  <button
    type="button"
    id="code-toggle"
    class="accent-fill flex cursor-pointer items-center gap-2 self-center rounded-l-lg py-5 pl-1 text-white shadow-md"
    aria-expanded={String(config.code)}
    aria-controls="code-body"
    aria-label="Show the code behind this demo"
    title="Show the code behind this demo"
  >
    <svg
      id="code-chevron"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 18l-6-6 6-6"></path>
    </svg>
    <span class="toggle-label text-xs font-medium tracking-wide">Code</span>
  </button>
  <div id="code-body" class={`code-body overflow-y-auto ${theme.page.surface} border-l ${theme.page.border}`}>
    <div class="px-4 py-4">
      <p class={`text-xs font-medium tracking-widest uppercase ${theme.page.muted}`}>Under the hood</p>
      <div class="mt-4 flex items-center justify-between gap-3">
        <div class="flex gap-1" role="tablist">
          {
            [...TABS, {id: 'events', label: 'Events'}].map((t) => (
              <button
                type="button"
                role="tab"
                class={tab}
                data-tab={t.id}
                aria-selected={t.id === config.tab ? 'true' : 'false'}
                style={t.id === config.tab ? `background: ${theme.page.accent}; color: white` : ''}
              >
                {t.label}
              </button>
            ))
          }
        </div>
        <button type="button" id="code-copy" class={`${tab} border ${theme.page.border}`}>Copy</button>
      </div>
      {
        panes.map((t) => (
          <pre
            class={`mt-3 overflow-x-auto ${theme.page.radius} border ${theme.page.border} bg-white p-3 text-[11px] leading-relaxed`}
            data-pane={t.id}
            hidden={t.id !== config.tab}
            set:html={t.html}
          />
        ))
      }
      <div
        class={`mt-3 ${theme.page.radius} border ${theme.page.border} bg-white p-3 text-[11px]`}
        data-pane="events"
        hidden={config.tab !== 'events'}
      >
        <p class={theme.page.muted} id="events-empty">Nothing yet. Interact with the checkout.</p>
        <ol class="space-y-1" id="events-list"></ol>
      </div>
      <p class={`mt-3 text-[11px] ${theme.page.muted}`}>
        Illustrative — the running demo adds error handling and validation these extracts leave out.
      </p>
    </div>
  </div>
</aside>
