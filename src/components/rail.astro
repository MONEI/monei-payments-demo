---
import {LANGUAGES, THEMES} from '../lib/config.js';
import {THEME_DATA} from '../data/themes.js';

const {theme, config, enabled} = Astro.props;

const METHOD_LABELS = {
  card: 'Card',
  applePay: 'Apple Pay',
  googlePay: 'Google Pay',
  paypal: 'PayPal',
  bizum: 'Bizum'
};

const row = `flex items-center justify-between gap-3 text-sm`;
const hint = `text-[11px] ${theme.page.muted}`;
---

<aside id="rail" data-open="false" class="fixed top-0 left-0 z-40 flex h-full">
  <div id="rail-body" class={`rail-body overflow-y-auto ${theme.page.surface} border-r ${theme.page.border}`}>
    <div class="w-72 px-4 py-4">
      <p class={`text-xs font-medium tracking-widest uppercase ${theme.page.muted}`}>Customize this demo</p>
      <section class="mt-4">
        <h3 class={`text-xs font-medium ${theme.page.muted}`}>Theme</h3>
        <div class="mt-2 space-y-1.5">
          {
            THEMES.map((name) => (
              <label class={row}>
                <span class="flex items-center gap-2">
                  <input
                    type="radio"
                    name="theme"
                    value={name}
                    checked={config.theme === name}
                    disabled={!THEME_DATA[name]}
                    data-param="theme"
                  />
                  {name}
                </span>
                {!THEME_DATA[name] && <span class={hint}>not built yet</span>}
              </label>
            ))
          }
        </div>
      </section>
      <section class={`mt-5 border-t ${theme.page.border} pt-4`}>
        <h3 class={`text-xs font-medium ${theme.page.muted}`}>Cart</h3>
        <p class={`mt-1 ${hint}`}>Adjust quantities in the order summary, or add items from the shop.</p>
      </section>
      <section class={`mt-5 border-t ${theme.page.border} pt-4`}>
        <h3 class={`text-xs font-medium ${theme.page.muted}`}>Payment methods</h3>
        <div class="mt-2 space-y-1.5">
          {
            Object.entries(METHOD_LABELS).map(([id, label]) => {
              const onAccount = enabled === null || enabled.includes(id);
              return (
                <label class={row}>
                  <span class="flex items-center gap-2">
                    <input
                      type="checkbox"
                      value={id}
                      checked={onAccount && (config.methods.length === 0 || config.methods.includes(id))}
                      disabled={!onAccount}
                      data-method={id}
                    />
                    {label}
                  </span>
                  {!onAccount && <span class={hint}>not on this account</span>}
                </label>
              );
            })
          }
        </div>
      </section>
      <section class={`mt-5 border-t ${theme.page.border} pt-4`}>
        <h3 class={`text-xs font-medium ${theme.page.muted}`}>Shipping zones</h3>
        <dl class={`mt-2 space-y-1 text-[11px] ${theme.page.muted}`}>
          <div class="flex justify-between"><dt>Mainland ES</dt><dd>€4.99</dd></div>
          <div class="flex justify-between"><dt>Canary Is. (35…, 38…)</dt><dd>€14.99</dd></div>
          <div class="flex justify-between"><dt>International</dt><dd>€19.99</dd></div>
          <div class="flex justify-between"><dt>United Kingdom</dt><dd>not served</dd></div>
        </dl>
      </section>
      <details class={`mt-5 border-t ${theme.page.border} pt-4`}>
        <summary class={`cursor-pointer text-xs font-medium ${theme.page.muted}`}>Advanced</summary>
        <div class="mt-3">
          <label class="block">
            <span class={`text-xs ${theme.page.muted}`}>Language</span>
            <select
              class={`mt-1 w-full ${theme.page.radius} border ${theme.page.border} bg-white px-2 py-1.5 text-sm`}
              data-param="lang"
            >
              {
                LANGUAGES.map((code) => (
                  <option value={code} selected={config.lang === code}>
                    {code}
                  </option>
                ))
              }
            </select>
          </label>
        </div>
      </details>
      <p class={`mt-5 ${hint}`}>Every setting lives in the URL, so this link reproduces it.</p>
    </div>
  </div>
  <button
    type="button"
    id="rail-toggle"
    class="cursor-pointer self-center rounded-r-lg py-5 pr-1 pl-0.5 text-white shadow-md"
    style={`background: ${theme.page.accent}`}
    aria-expanded="false"
    aria-controls="rail-body"
    aria-label="Customize this demo"
    title="Customize this demo"
  >
    <svg
      id="rail-chevron"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 18l6-6-6-6"></path>
    </svg>
  </button>
</aside>
