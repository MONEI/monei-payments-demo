---
const {theme} = Astro.props;

const CARDS = [
  {number: '4444 4444 4444 4422', label: 'Visa · Frictionless'},
  {number: '5555 5555 5555 5532', label: 'Mastercard · Frictionless'},
  {number: '4444 4444 4444 4406', label: 'Visa · 3DS challenge'},
  {number: '5555 5555 5555 5565', label: 'Mastercard · 3DS challenge'}
];

const PAYPAL = [
  {value: 'paypal-personal@monei.net', label: 'Sandbox buyer'},
  {value: 'monei12345', label: 'Password'}
];

// Fira Code is wider than the sans, so a card number no longer fits the column at its
// natural spacing. Tightened, and held to one line from `sm` up — a phone is narrower
// than any tracking can rescue, so there it wraps.
// `text-left` because a button centres its text by default, which reads as adrift on
// the one value narrow enough to wrap.
const copyButton = `copy accent-text cursor-pointer text-left font-mono text-xs tracking-tight tabular-nums underline decoration-dotted sm:whitespace-nowrap`;
---

<section class={`${theme.page.radius} border ${theme.page.border} ${theme.page.surface} p-5`}>
  <h2 class={`text-sm ${theme.page.heading}`}>Paying in test mode</h2>
  <p class={`mt-1 text-xs ${theme.page.muted}`}>
    Any of these cards works. Expiry <strong>12/34</strong>, CVC <strong>123</strong>.
  </p>
  <ul class="mt-3 space-y-1.5">
    {
      CARDS.map((card) => (
        <li class="flex items-center gap-2">
          <span class="relative shrink-0">
            <button type="button" class={copyButton} data-copy={card.number.replace(/ /g, '')}>
              {card.number}
            </button>
            <span class="copied">Copied</span>
          </span>
          <span class={`text-xs ${theme.page.muted}`}>{card.label}</span>
        </li>
      ))
    }
  </ul>
  <div class={`mt-4 border-t ${theme.page.border} pt-3`}>
    <h3 class={`text-xs font-medium ${theme.page.muted}`}>PayPal sandbox</h3>
    <ul class="mt-2 space-y-1.5">
      {
        PAYPAL.map((entry) => (
          <li class="flex items-center gap-2">
            <span class="relative min-w-0">
              <button type="button" class={copyButton} data-copy={entry.value}>
                {entry.value}
              </button>
              <span class="copied">Copied</span>
            </span>
            <span class={`text-xs ${theme.page.muted}`}>{entry.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <p class={`mt-3 text-xs ${theme.page.muted}`}>
    <a class="underline" href="https://docs.monei.com/testing/" rel="noopener"> Full list of test cards </a>
  </p>
</section>

<script>
  // A module is evaluated once and survives client-side navigation, so the buttons
  // of every later render need wiring on the event rather than at import time.
  const wire = () => {
    for (const button of document.querySelectorAll('.copy')) {
      if (button.dataset.wired === 'true') continue;
      button.dataset.wired = 'true';

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy);
        } catch {
          return;
        }
        // A toast over the number rather than in place of it: swapping the label
        // reflowed the row, and the value is what the reader came for.
        button.parentElement.querySelector('.copied')?.classList.add('is-shown');
        clearTimeout(button.dataset.timer);
        button.dataset.timer = setTimeout(
          () => button.parentElement.querySelector('.copied')?.classList.remove('is-shown'),
          1200
        );
      });
    }
  };

  document.addEventListener('astro:page-load', wire);
</script>
