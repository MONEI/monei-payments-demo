---
import '../styles/global.css';
import {ClientRouter} from 'astro:transitions';
import {STORE} from '../data/store.js';

const {theme, title} = Astro.props;
const preview = new URL('/images/preview.jpg', Astro.site).href;
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="https://assets.monei.com/images/icon.png" />
    <title>{title ? `${title} — ${STORE.name}` : STORE.name}</title>
    <meta name="description" content={STORE.description} />
    <meta property="og:title" content={STORE.name} />
    <meta property="og:description" content={STORE.description} />
    <meta property="og:image" content={preview} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={preview} />
    {
      /* The page's own faces are served from this origin and preloaded, so the first
        paint already has them and nothing swaps. The card iframes fetch the Google
        sheet themselves — they are cross-origin and cannot use ours. */
    }
    {
      theme.card.preload?.map((file) => (
        <link rel="preload" href={`/fonts/${file}`} as="font" type="font/woff2" crossorigin />
      ))
    }
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline defer src="https://js.monei.com/v3/monei.js"></script>
    <ClientRouter />
  </head>
  <body
    class={`min-h-full ${theme.page.body}`}
    data-numerals={theme.page.numerals ? '' : undefined}
    style={`font-family: ${theme.page.fontFamily}; --accent: ${theme.page.accent}; --accent-hover: ${theme.page.accentHover}${theme.page.numerals ? `; --numerals: ${theme.page.numerals}` : ''}`}
  >
    <slot />
  </body>
</html>
