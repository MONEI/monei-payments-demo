---
/**
 * Apple Pay driven directly, with no MONEI components in the way. The sheet opening
 * here but not on the store isolates the fault to the SDK; neither working points at
 * the domain, the certificate or the device instead.
 */
export const prerender = false;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Apple Pay — direct test</title>
    <style>
      body {
        margin: 0;
        padding: 1.25rem;
        font: 14px/1.5 system-ui, sans-serif;
      }
      #log {
        margin-top: 1rem;
        white-space: pre-wrap;
        font-family: ui-monospace, monospace;
        font-size: 12px;
      }
      #log div {
        padding: 0.25rem 0;
        border-bottom: 1px solid #eee;
      }
      apple-pay-button {
        --apple-pay-button-width: 100%;
        --apple-pay-button-height: 48px;
      }
    </style>
    <script src="https://applepay.cdn-apple.com/jsapi/v1/apple-pay-sdk.js" crossorigin async></script>
  </head>
  <body>
    <h1>Apple Pay, no SDK</h1>
    <p>Everything below talks to Apple directly. Only the merchant session is signed by our server.</p>
    <div id="button"></div>
    <div id="log"></div>

    <script is:inline>
      const log = (label, detail) => {
        const row = document.createElement('div');
        row.textContent = detail === undefined ? label : `${label} — ${JSON.stringify(detail)}`;
        document.getElementById('log').prepend(row);
      };

      const S = window.ApplePaySession;
      if (!S) {
        log('ApplePaySession missing — not Safari on Apple hardware');
      } else {
        log('supported versions', [1, 3, 4, 6, 10, 14].filter((v) => S.supportsVersion(v)).join(','));
        log('canMakePayments', S.canMakePayments());

        const button = document.createElement('apple-pay-button');
        button.setAttribute('buttonstyle', 'black');
        button.setAttribute('type', 'buy');
        button.setAttribute('locale', 'en');
        document.getElementById('button').append(button);

        // The SDK's handler is `async` and awaits `onBeforeOpen` before `begin()`.
        // `?await=1` reproduces that here: if the sheet then stops opening, the await
        // is the fault and dropping `onBeforeOpen` is the workaround.
        const mimicSdk = new URLSearchParams(location.search).has('await');

        button.addEventListener('click', async () => {
          log('tapped', {mimicSdk});
          if (mimicSdk) {
            await Promise.resolve(true);
            log('awaited, as the SDK does');
          }
          try {
            const version = S.supportsVersion(14) ? 14 : 3;
            const session = new S(version, {
              countryCode: 'ES',
              currencyCode: 'EUR',
              merchantCapabilities: ['supports3DS'],
              supportedNetworks: ['visa', 'masterCard'],
              total: {label: 'Direct test', type: 'final', amount: '1.00'}
            });
            log('session constructed', {version});

            session.onvalidatemerchant = async (event) => {
              log('onvalidatemerchant', {url: event.validationURL.slice(0, 48)});
              try {
                const response = await fetch('/api/apple-session', {
                  method: 'POST',
                  headers: {'content-type': 'application/json'},
                  body: JSON.stringify({validationUrl: event.validationURL, domainName: location.hostname})
                });
                const merchantSession = await response.json();
                log('session signed', {status: response.status, id: merchantSession.merchantSessionIdentifier?.slice(0, 16)});
                session.completeMerchantValidation(merchantSession);
                log('completeMerchantValidation ok');
              } catch (error) {
                log('validation FAILED', {error: String(error?.message ?? error)});
                session.abort();
              }
            };

            session.onpaymentauthorized = (event) => {
              log('authorized', {network: event.payment.token.paymentMethod.network});
              session.completePayment({status: S.STATUS_SUCCESS});
            };

            session.oncancel = () => log('cancelled by the shopper');

            session.begin();
            log('begin() called');
          } catch (error) {
            log('THREW', {error: String(error?.message ?? error)});
          }
        });
      }
    </script>
  </body>
</html>
