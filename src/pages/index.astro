---
import StoreLayout from '../layouts/store.astro';
import StoreHeader from '../components/store-header.astro';
import CartSummary from '../components/cart-summary.astro';
import AddressForm from '../components/address-form.astro';
import TestCards from '../components/test-cards.astro';
import CardForm from '../components/card-form.astro';
import ExpressCheckout from '../components/express-checkout.astro';
import CodePanel from '../components/code-panel.astro';
import Rail from '../components/rail.astro';
import {accountId, fetchAccountMethods} from '../lib/monei.js';
import ProductArt from '../components/product-art.astro';
import {PRODUCTS} from '../data/products.js';
import {cartLines, cartTotal, formatPrice} from '../lib/cart.js';
import {parseConfig, serializeCart, toQuery} from '../lib/config.js';
import {initialShippingOptions, zipDecidesZone} from '../lib/shipping.js';
import {countryList} from '../lib/countries.js';
import {cardUiFor, themeFor} from '../data/themes.js';

const config = parseConfig(Astro.url);
const theme = themeFor(config.theme);
const cardUi = cardUiFor(theme, config.cardUi);
const lines = cartLines(config.cart);
const total = cartTotal(config.cart);

const enabled = await fetchAccountMethods();
const quantities = new Map(config.cart.map((i) => [i.productId, i.quantity]));

const stepButton = `${theme.page.buttonRadius} flex h-11 w-11 cursor-pointer items-center justify-center disabled:cursor-default disabled:opacity-40`;
const stepIcon = {
  width: 16,
  height: 16,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 2.2,
  'stroke-linecap': 'round',
  'aria-hidden': 'true'
};

const canonicalQuery = config.seedGenerated ? toQuery(config) : null;
const failedPayment = Astro.url.searchParams.has('error');

const clientConfig = {
  accountId,
  currency: config.currency,
  goods: total,
  cart: serializeCart(config.cart),
  // Null means every method the account allows; an empty list means none.
  methods: config.methods,
  flow: config.flow,
  cardUi,
  cardStyle: theme.card.style,
  cardFonts: theme.card.fonts,
  walletRadius: theme.card.style.base.borderRadius,
  pageFont: theme.page.fontFamily,
  initialShippingOptions: initialShippingOptions(config.country),
  zipZones: countryList()
    .map((c) => c.code)
    .filter(zipDecidesZone),
  mutedClass: theme.page.muted
};
---

<StoreLayout theme={theme}>
  <Rail theme={theme} config={config} enabled={enabled} cardUi={cardUi} />
  <CodePanel theme={theme} config={config} clientConfig={clientConfig} />
  <StoreHeader theme={theme} config={config} />
  <main id="cart-root" class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    {
      failedPayment && (
        <p class={`${theme.page.radius} mb-6 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700`}>
          That payment did not complete. Nothing was charged — try again below.
        </p>
      )
    }
    <p class={`text-[17px] leading-normal ${theme.page.muted}`}>
      A working checkout built on <a class="underline" href="https://docs.monei.com/monei-js/overview/" rel="noopener"
        >MONEI Components</a
      >. Nothing charges a real card.
    </p>
    {
      /* `minmax(0,…)` rather than the default `minmax(auto,…)`, which never shrinks a
         column below the widest thing in it — here a product card, which held the
         whole page open on a narrow screen. */
    }
    <div class="mt-8 flex flex-col gap-10 lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
      {
        /* Stacked, the cart belongs between the shop and the form it prices, so this
           wrapper collapses on a phone and `order` sequences all three as siblings.
           From `lg` it is a column again, keeping the checkout under the shop instead
           of level with the end of the taller right-hand column. */
      }
      <div class="contents lg:flex lg:flex-col lg:gap-10">
        <section class="order-1">
          <h2 class={`text-xl ${theme.page.heading}`}>Shop</h2>
          <ul class="mt-6 grid gap-3.5 sm:grid-cols-2">
            {
              PRODUCTS.map((product) => (
                <li
                  class={`${theme.page.surface} ${theme.page.radius} border-[1.5px] ${theme.page.border} flex items-start gap-3.5 py-[18px] pr-[18px] pl-4`}
                  data-shop-item={product.id}
                  data-in-cart={quantities.has(product.id) ? '' : undefined}
                >
                  <ProductArt art={product.art} class={`h-[52px] w-[52px] shrink-0 ${theme.page.muted}`} />
                  <div class="flex min-w-0 flex-1 flex-col gap-1 self-stretch">
                    <p class="text-[17px] font-semibold">{product.name}</p>
                    <p class={`text-sm leading-[1.4] ${theme.page.muted}`}>{product.detail}</p>
                    {product.weight && <p class={`text-[13px] tabular-nums ${theme.page.muted}`}>{product.weight}</p>}
                    <div class="mt-auto flex items-center justify-between gap-3 pt-2.5">
                      <span class="text-lg font-medium tabular-nums">{formatPrice(product.price)}</span>
                      <button
                        type="button"
                        class={`${theme.page.buttonRadius} flex h-11 cursor-pointer items-center gap-1.5 pr-[18px] pl-3.5 text-[15px] font-semibold text-white accent-fill disabled:cursor-default disabled:opacity-40`}
                        data-cart-add={product.id}
                        aria-label={`Add ${product.name} to cart`}
                        hidden={quantities.has(product.id)}
                      >
                        <svg {...stepIcon}>
                          <path d="M5 12h14M12 5v14" />
                        </svg>
                        Add
                      </button>
                      <div
                        class={`${theme.page.buttonRadius} flex h-11 items-center px-0.5 text-white accent-fill`}
                        data-shop-stepper
                        hidden={!quantities.has(product.id)}
                      >
                        <button
                          type="button"
                          class={stepButton}
                          data-cart-step={product.id}
                          data-delta="-1"
                          aria-label={`One fewer ${product.name}`}
                        >
                          <svg {...stepIcon}>
                            <path d="M5 12h14" />
                          </svg>
                        </button>
                        <span class="min-w-5 text-center font-medium tabular-nums" data-shop-qty>
                          {quantities.get(product.id) ?? 0}
                        </span>
                        <button
                          type="button"
                          class={stepButton}
                          data-cart-step={product.id}
                          data-delta="1"
                          aria-label={`One more ${product.name}`}
                        >
                          <svg {...stepIcon}>
                            <path d="M5 12h14M12 5v14" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </section>
        <div class="order-3 space-y-6">
          <ExpressCheckout theme={theme} flow={config.flow} />
          <AddressForm theme={theme} country={config.country} />
          <CardForm theme={theme} flow={config.flow} cardUi={cardUi} />
        </div>
      </div>
      <aside class="order-2 space-y-4">
        <CartSummary theme={theme} lines={lines} total={total} />
        <TestCards theme={theme} />
      </aside>
    </div>
  </main>
  <div id="pay-overlay" role="status" hidden>
    <span class="spinner" aria-hidden="true"></span>
    <span class="sr-only">Processing payment…</span>
  </div>
  {/* The rails' own view state stays out of shared links, but not out of this tab's URL. */}
  {
    canonicalQuery && (
      <script
        is:inline
        set:html={`const q = new URLSearchParams('${canonicalQuery}'); const own = new URLSearchParams(location.search); for (const k of ['panel', 'code', 'tab']) if (own.has(k)) q.set(k, own.get(k)); history.replaceState(history.state, '', '?' + q);`}
      />
    )
  }
  <script id="demo-config" type="application/json" set:html={JSON.stringify(clientConfig)} />
  <script id="demo-cart" type="application/json" set:html={JSON.stringify(config.cart)} />
  <script>
    import '../client/checkout.js';
    import '../client/panels.js';
    import '../client/code-panel.js';
    import {initCartUi} from '../client/cart-ui.js';

    document.addEventListener('astro:page-load', () => {
      const cart = document.getElementById('demo-cart');
      if (cart) initCartUi(JSON.parse(cart.textContent));
    });
  </script>
</StoreLayout>
