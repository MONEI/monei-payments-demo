---
import '../styles/global.css';
import ProductArt from '../components/product-art.astro';
import {PRODUCTS} from '../data/products.js';
import {cartLines, cartTotal, formatPrice} from '../lib/cart.js';
import {parseConfig, toQuery} from '../lib/config.js';

const config = parseConfig(Astro.url);
const lines = cartLines(config.cart);
const total = cartTotal(config.cart);

// When the seed was invented for this request, hand the canonical query string
// to the client so it can replaceState — putting a shareable URL in the address
// bar without a redirect.
const canonicalQuery = config.seedGenerated ? toQuery(config) : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MONEI Payments Demo</title>
  </head>
  <body class="bg-stone-50 text-stone-900">
    <main class="mx-auto max-w-4xl px-6 py-16">
      <p class="text-xs font-medium tracking-widest text-stone-500 uppercase">Test mode</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Coffee roastery</h1>
      <p class="mt-2 text-stone-600">Catalogue and seeded cart (task 2). Storefront proper lands in task 4.</p>
      <h2 class="mt-12 text-sm font-medium tracking-widest text-stone-500 uppercase">Catalogue</h2>
      <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          PRODUCTS.map((p) => (
            <li class="rounded-lg border border-stone-200 bg-white p-4">
              <ProductArt art={p.art} class="h-16 w-16 text-stone-700" />
              <p class="mt-3 text-sm font-medium">{p.name}</p>
              <p class="mt-0.5 text-xs text-stone-500">{p.detail}</p>
              <p class="mt-2 text-sm tabular-nums">{formatPrice(p.price)}</p>
            </li>
          ))
        }
      </ul>
      <h2 class="mt-12 text-sm font-medium tracking-widest text-stone-500 uppercase">
        Cart for seed <code class="font-mono normal-case">{config.seed}</code>
        {config.cartEdited && <span class="normal-case">(edited)</span>}
      </h2>
      <ul class="mt-4 divide-y divide-stone-200 border-y border-stone-200">
        {
          lines.map((line) => (
            <li class="flex items-center gap-4 py-3">
              <ProductArt art={line.art} class="h-10 w-10 shrink-0 text-stone-600" />
              <span class="flex-1 text-sm">
                {line.quantity} × {line.name}
              </span>
              <span class="text-sm tabular-nums">{formatPrice(line.lineTotal)}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-right text-sm font-medium tabular-nums">Total {formatPrice(total)}</p>
      <p class="mt-6 text-xs text-stone-500">
        Reload to keep this cart, or <a class="underline" href="/">start a new one</a>. The same seed always produces
        the same order, so a shared link shows the recipient exactly what the sender saw.
      </p>

      <h2 class="mt-12 text-sm font-medium tracking-widest text-stone-500 uppercase">Config (task 3)</h2>
      <dl class="mt-4 grid grid-cols-[8rem_1fr] gap-y-1 text-sm">
        <dt class="text-stone-500">theme</dt><dd>{config.theme}</dd>
        <dt class="text-stone-500">layout</dt><dd>{config.layout}</dd>
        <dt class="text-stone-500">flow</dt><dd>{config.flow}</dd>
        <dt class="text-stone-500">lang</dt><dd>{config.lang}</dd>
        <dt class="text-stone-500">currency</dt><dd>{config.currency}</dd>
        <dt class="text-stone-500">country</dt><dd>{config.country ?? '—'}</dd>
        <dt class="text-stone-500">methods</dt>
        <dd>{config.methods.length ? config.methods.join(', ') : 'all the account allows'}</dd>
        <dt class="text-stone-500">shipping</dt><dd>{String(config.shipping)}</dd>
        <dt class="text-stone-500">billing</dt><dd>{String(config.billing)}</dd>
      </dl>
      <p class="mt-4 text-xs text-stone-500">
        Try <a class="underline" href="/?theme=nonsense&methods=hack&seed=../../etc">a mangled link</a> — every unknown value
        falls back to its default instead of erroring.
      </p>
    </main>

    {canonicalQuery && <script is:inline set:html={`history.replaceState(null, '', '?${canonicalQuery}');`} />}
  </body>
</html>
