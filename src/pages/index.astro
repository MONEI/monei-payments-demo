---
import '../styles/global.css';
import ProductArt from '../components/product-art.astro';
import {PRODUCTS} from '../data/products.js';
import {seededCart, cartLines, cartTotal, formatPrice, newSeed} from '../lib/cart.js';

// Task 3 moves seed handling into the config model; this is enough to see the
// catalogue and the seeded cart render.
const seed = Astro.url.searchParams.get('seed') || newSeed();
const cart = seededCart(seed);
const lines = cartLines(cart);
const total = cartTotal(cart);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MONEI Payments Demo</title>
  </head>
  <body class="bg-stone-50 text-stone-900">
    <main class="mx-auto max-w-4xl px-6 py-16">
      <p class="text-xs font-medium tracking-widest text-stone-500 uppercase">Test mode</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Coffee roastery</h1>
      <p class="mt-2 text-stone-600">
        Catalogue and seeded cart (task 2). Storefront proper lands in task 4.
      </p>
      <h2 class="mt-12 text-sm font-medium tracking-widest text-stone-500 uppercase">Catalogue</h2>
      <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          PRODUCTS.map((p) => (
            <li class="rounded-lg border border-stone-200 bg-white p-4">
              <ProductArt art={p.art} class="h-16 w-16 text-stone-700" />
              <p class="mt-3 text-sm font-medium">{p.name}</p>
              <p class="mt-0.5 text-xs text-stone-500">{p.detail}</p>
              <p class="mt-2 text-sm tabular-nums">{formatPrice(p.price)}</p>
            </li>
          ))
        }
      </ul>
      <h2 class="mt-12 text-sm font-medium tracking-widest text-stone-500 uppercase">
        Cart for seed <code class="font-mono normal-case">{seed}</code>
      </h2>
      <ul class="mt-4 divide-y divide-stone-200 border-y border-stone-200">
        {
          lines.map((line) => (
            <li class="flex items-center gap-4 py-3">
              <ProductArt art={line.art} class="h-10 w-10 shrink-0 text-stone-600" />
              <span class="flex-1 text-sm">
                {line.quantity} × {line.name}
              </span>
              <span class="text-sm tabular-nums">{formatPrice(line.lineTotal)}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-right text-sm font-medium tabular-nums">Total {formatPrice(total)}</p>
      <p class="mt-6 text-xs text-stone-500">
        Reload to keep this cart, or <a class="underline" href="/">start a new one</a>. The same
        seed always produces the same order, so a shared link shows the recipient exactly what the
        sender saw.
      </p>
    </main>
  </body>
</html>
