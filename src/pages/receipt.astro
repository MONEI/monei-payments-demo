---
import StoreLayout from '../layouts/store.astro';
import StoreHeader from '../components/store-header.astro';
import {formatPrice} from '../lib/cart.js';
import {themeFor} from '../data/themes.js';
import {monei} from '../lib/monei.js';
import {parseConfig, toQuery} from '../lib/config.js';
import {RECEIPT_COOKIE} from '../lib/payment.js';

const config = parseConfig(Astro.url);
const theme = themeFor(config.theme);
const id = Astro.url.searchParams.get('id');

// Retrying is the same order again, so it keeps the cart. "Create another order" is
// a new one, so seed and cart are dropped and the store generates fresh ones.
const retryHref = `/?${toQuery(config)}`;
const nextOrderHref = `/?${toQuery({...config, seed: null, cart: null, cartEdited: false})}`;

let payment = null;
let lookupError = null;

if (id && monei) {
  try {
    payment = await monei.payments.get(id);
  } catch (error) {
    lookupError = error.message ?? 'Could not load this payment';
  }
}

// These are not failures: a 3D Secure return or a Bizum challenge lands here before
// the payment processor has confirmed, and a "Try again" button would let the
// shopper pay twice.
const PENDING = ['PENDING', 'PENDING_PROCESSING'];
// Only these end with no money taken, so only these offer a retry. Anything else —
// authorized, refunded, paid out — is shown as it is.
const FAILED = ['FAILED', 'CANCELED', 'EXPIRED'];
const state = !payment
  ? 'unknown'
  : payment.status === 'SUCCEEDED'
    ? 'succeeded'
    : PENDING.includes(payment.status)
      ? 'pending'
      : FAILED.includes(payment.status)
        ? 'failed'
        : 'other';
const statusText = payment?.status?.toLowerCase().replaceAll('_', ' ');

// A receipt link can be shared, so the shopper's details show only in the browser
// that opened this payment; anyone else sees the order, amount and status.
const owner = Boolean(payment) && Astro.cookies.get(RECEIPT_COOKIE)?.value === payment.id;
const customer = owner ? payment.customer : null;

const method = (() => {
  if (!owner) return null;
  const pm = payment?.paymentMethod;
  if (!pm) return null;
  if (pm.bizum) return `Bizum · ${pm.bizum.phoneNumber ?? ''}`.trim();
  if (pm.paypal) return `PayPal · ${pm.paypal.orderId ?? ''}`.trim();
  if (pm.card) return `${pm.card.brand ?? 'Card'} · ${pm.card.last4 ?? ''}`.trim();
  return pm.method ?? null;
})();

const formatAddress = (details) => {
  const a = details?.address;
  if (!a) return null;
  const parts = [a.line1, a.line2, [a.city, a.state, a.zip].filter(Boolean).join(', '), a.country];
  return parts.filter(Boolean).join(' · ');
};
const shippingAddress = owner ? formatAddress(payment.shippingDetails) : null;
const billingAddress = owner ? formatAddress(payment.billingDetails) : null;

const card = `${theme.page.surface} ${theme.page.radius} border ${theme.page.border} p-6`;
const button = `${theme.page.radius} block w-full px-4 py-2.5 text-center text-sm font-medium`;
---

<StoreLayout theme={theme} title="Receipt">
  <StoreHeader theme={theme} config={config} />
  <main class="mx-auto max-w-xl px-6 py-12">
    {
      state === 'succeeded' && (
        <>
          <h1 class={`text-2xl ${theme.page.heading}`}>Thank you{customer?.name ? `, ${customer.name}` : ''}!</h1>
          <p class={`mt-2 text-sm ${theme.page.muted}`}>
            Order <strong>{payment.orderId}</strong> is confirmed.
          </p>
        </>
      )
    }
    {
      state === 'pending' && (
        <>
          <h1 class={`text-2xl ${theme.page.heading}`}>Payment processing</h1>
          <p class={`mt-2 text-sm ${theme.page.muted}`}>
            The payment processor has not confirmed this payment yet. This page checks again every few seconds for about
            a minute — the webhook is what confirms it server-side.
          </p>
        </>
      )
    }
    {
      state === 'failed' && (
        <>
          <h1 class={`text-2xl ${theme.page.heading}`}>Payment not completed</h1>
          <p class={`mt-2 text-sm ${theme.page.muted}`}>{payment.statusMessage ?? 'The payment did not go through.'}</p>
        </>
      )
    }
    {
      state === 'other' && (
        <>
          <h1 class={`text-2xl ${theme.page.heading}`}>Payment {statusText}</h1>
          <p class={`mt-2 text-sm ${theme.page.muted}`}>
            Order <strong>{payment.orderId}</strong> is {statusText}.
          </p>
        </>
      )
    }
    {
      state === 'unknown' && (
        <>
          <h1 class={`text-2xl ${theme.page.heading}`}>No payment to show</h1>
          <p class={`mt-2 text-sm ${theme.page.muted}`}>{lookupError ?? 'This link has no payment id.'}</p>
        </>
      )
    }
    {
      /* The label column is fixed, so on a phone it would leave the values too little
         room to wrap in — they take their own row there instead. `minmax(0,…)` lets the
         value column shrink; the default never goes below its own content. */
    }
    {
      payment && (
        <dl class={`mt-8 ${card} grid gap-y-2 text-sm break-words sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-x-2`}>
          <dt class={theme.page.muted}>Order</dt>
          <dd>{payment.orderId}</dd>
          <dt class={theme.page.muted}>Amount</dt>
          <dd class="tabular-nums">{formatPrice(payment.amount, payment.currency)}</dd>
          <dt class={theme.page.muted}>Status</dt>
          <dd>{payment.status}</dd>
          {customer?.name && (
            <>
              <dt class={theme.page.muted}>Name</dt>
              <dd>{customer.name}</dd>
            </>
          )}
          {customer?.email && (
            <>
              <dt class={theme.page.muted}>Email</dt>
              <dd>{customer.email}</dd>
            </>
          )}
          {method && (
            <>
              <dt class={theme.page.muted}>Payment method</dt>
              <dd>{method}</dd>
            </>
          )}
          {shippingAddress && (
            <>
              <dt class={theme.page.muted}>Shipping address</dt>
              <dd>{shippingAddress}</dd>
            </>
          )}
          {billingAddress && (
            <>
              <dt class={theme.page.muted}>Billing address</dt>
              <dd>{billingAddress}</dd>
            </>
          )}
        </dl>
      )
    }
    <div class="mt-8 space-y-3">
      {
        state === 'failed' && (
          <a class={`${button} text-white accent-fill`} href={`${retryHref}&error=1`}>
            Try again
          </a>
        )
      }
      <a class={`${button} border ${theme.page.border}`} href={nextOrderHref}> Create another order </a>
      <a class={`${button} text-white accent-fill`} href="https://dashboard.monei.com/?action=signUp" rel="noopener">
        Create account
      </a>
    </div>
    <p class={`mt-6 text-xs ${theme.page.muted}`}>
      See the <a class="underline" href="https://docs.monei.com/" rel="noopener">documentation</a> for integrating these payment
      methods into your own checkout.
    </p>
  </main>
  {
    /* Each check is a MONEI API call, so an abandoned tab stops after about a minute.
      The client router keeps the timer alive across a navigation, so it checks it is still here. */
  }
  {
    state === 'pending' && (
      <script
        is:inline
        set:html="const u = new URL(location.href); const n = Number(u.searchParams.get('poll') || 0); if (n < 15) setTimeout(() => { if (location.href !== u.href) return; u.searchParams.set('poll', String(n + 1)); location.replace(u); }, 4000);"
      />
    )
  }
  {/* The address is kept for a retry, and a paid order has nothing to retry. */}
  {state === 'succeeded' && <script is:inline set:html="try { sessionStorage.removeItem('monei:address') } catch {}" />}
</StoreLayout>
