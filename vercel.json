{
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {"key": "Access-Control-Allow-Origin", "value": "*"},
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [{"key": "Content-Type", "value": "text/plain"}]
    }
  ]
}
